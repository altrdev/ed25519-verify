{
    "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
    "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
    "files": { "includes": ["src/**", "vite.config.ts", "!src/__tests__/fixtures"] },
    "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 4, "lineWidth": 140 },
    "css": { "formatter": { "enabled": false }, "linter": { "enabled": false } },
    "linter": { "enabled": true, "rules": { "preset": "recommended", "style": { "noNonNullAssertion": "off" } } },
    "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" } },
    "assist": { "enabled": true, "actions": { "source": { "organizeImports": "off" } } }
}
